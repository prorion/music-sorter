# .env로 복사해서 사용하세요. .env는 커밋되지 않습니다.

# 음악 폴더 경로
MUSIC_ROOT=

# SQLite DB 파일 경로
DB_PATH=./data/music-sorter.db

# Last.fm API 키 (https://www.last.fm/api/account/create)
LASTFM_API_KEY=

# MusicBrainz 요청 시 필수 User-Agent 연락처 (이메일 또는 URL)
MUSICBRAINZ_CONTACT=

# LLM API 키 (사용할 서비스 확정 후 이름 조정)
LLM_API_KEY=
