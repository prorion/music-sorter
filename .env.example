# 설정 항목 목록과 명시적 개발 프로필의 입력 예시입니다. GUI·일반 설정은 구현, .env 로더는 미구현입니다.
# 필요할 때 .env로 복사합니다. 일반 GUI는 .env·환경 변수를 자동으로 읽지 않습니다.
# GUI 키는 Windows 자격 증명 저장소, 일반 설정은 로컬 settings.json에 저장합니다.
# 저장·우선순위는 SPEC §15.4가 정본입니다. 실제 키·연락처·개인 경로는 커밋하지 않습니다.

# 일반 (system / light / dark). 종료 시 작업 상태 저장·자동 유료 재개 금지는 고정 동작입니다.
UI_THEME=system
UI_FONT_SCALE=1.0
NOTIFY_ON_COMPLETION=true

# 라이브러리: 빈 루트는 미등록. 하위 폴더 포함, 루트 밖 링크 따라가기 기본 끄기.
# 제외 폴더는 JSON 배열, 상대 경로는 명시적으로 선택한 .env 폴더 기준입니다.
MUSIC_ROOT=
SCAN_INCLUDE_SUBFOLDERS=true
SCAN_FOLLOW_EXTERNAL_LINKS=false
SCAN_EXCLUDE_FOLDERS=[]

# 비워 두면 로컬 사용자 데이터의 기본 위치. DB 생성 이후 위치 변경은 별도 이관 작업입니다.
DB_PATH=
BACKUP_PATH=
ROLLBACK_PATH=

# ffprobe는 선택적 도구. 빈 값이면 설치된 도구를 탐색하고 없으면 가능한 로컬 스캔만 제공합니다.
FFPROBE_PATH=

# API 키: GUI에서는 자격 증명 저장소 사용. 아래는 선택한 개발 프로필 전용입니다.
ANTHROPIC_API_KEY=
# 여러 워크스페이스용 키에 필요. 특정 워크스페이스용 키는 비워 둘 수 있습니다.
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
LASTFM_API_KEY=

# 분류 서비스 (anthropic / openai). 기존 초기 모델을 유지하며 성능은 샘플 평가로 확인합니다.
CLASSIFY_PROVIDER=anthropic
CLASSIFY_MODEL=claude-haiku-4-5
ESCALATE_ENABLED=true
ESCALATE_PROVIDER=anthropic
ESCALATE_MODEL=claude-sonnet-5-5

# batch / sync: 지원하지 않는 조합은 제출 보류. 묶음·구간 크기는 초기값입니다.
LLM_EXECUTION_MODE=batch
TRACKS_PER_REQUEST=20
BATCH_SEGMENT_TRACKS=1000

# 작업별 USD 예산·모델별 출력 토큰 상한이 없으면 유료 제출을 보류합니다.
# 예산 경고 기준: 0~1 비율. 신뢰도 임계값·출력 상한은 평가/모델 기능 확인 뒤 지정합니다.
LLM_JOB_BUDGET_USD=
BUDGET_WARNING_RATIO=0.8
CLASSIFY_MAX_OUTPUT_TOKENS=
ESCALATE_MAX_OUTPUT_TOKENS=
CLASSIFY_CONFIDENCE_THRESHOLD=
ESCALATE_CONFIDENCE_THRESHOLD=

# 가사 기본 끄기. 켜면 기존 ID3 가사 앞부분을 재판정 단계에만 전송합니다 (SPEC §7.5).
CLASSIFY_INCLUDE_LYRICS=false
LYRICS_MAX_CHARS=2000

# 고급: 최초 요청 제외 최대 3회. SDK와 중첩 금지, 처리 불확실·인증 오류에는 자동 적용하지 않음.
# 동시 요청 수·타임아웃은 계정/모델 제약 확인 후 지정. 디스크 읽기 동시성 기본 1.
API_MAX_RETRIES=3
API_CONCURRENCY=
API_TIMEOUT_SECONDS=
SCAN_READ_CONCURRENCY=1
LOG_LEVEL=INFO

# 외부 정보: 연락처·키 없으면 해당 출처를 건너뛰고 표시합니다.
# MusicBrainz는 전역 초당 최대 1건. 필수 User-Agent 연락처는 이메일 또는 URL입니다.
MUSICBRAINZ_ENABLED=true
MUSICBRAINZ_CONTACT=
LASTFM_ENABLED=true

# 중복 후보의 초기 길이 허용값. 샘플 검증 전 적합성이 확인된 값은 아닙니다.
DUPLICATE_DURATION_TOLERANCE_SECONDS=3

# 파일 적용: 항상 미리보기로 시작. 세 항목은 초기에는 선택하지 않고 적용 화면에서 고릅니다.
FILE_RENAME_ENABLED=false
FILE_ORGANIZE_ENABLED=false
FILE_WRITE_GENRE_ENABLED=false

# 재생목록: 상대 경로·일반/검토 구분은 고정. 실제 앱 호환성 검증 후 프로필 조정 가능.
# 종류는 JSON 배열, 첫 버전 기본은 세부 장르·분위기·컨셉과 두 검토 목록입니다.
PLAYLIST_TYPES=["subgenre","mood","concept","unresolved_review","duplicate_review"]
PLAYLIST_ENCODING=utf-8
PLAYLIST_LINE_ENDING=CRLF

# 데이터·복구: 하루 첫 적용 전 및 스키마 변경 전 DB 백업. 원본 ID3 자료 자동 만료 없음.
# 자동 DB 백업만 최근 7개. 수동 백업·원본 복구 자료는 사용자 명시 정리 대상입니다.
DB_BACKUP_DAILY_BEFORE_APPLY=true
DB_BACKUP_KEEP_AUTO=7
ROLLBACK_STORAGE_LIMIT_GIB=10
ROLLBACK_WARNING_RATIO=0.8
