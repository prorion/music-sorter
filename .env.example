# .env로 복사해서 사용하세요. .env는 커밋되지 않습니다.

# 음악 폴더 경로
MUSIC_ROOT=

# SQLite DB 파일 경로
DB_PATH=./data/music-sorter.db

# Anthropic API 키 (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# OpenAI API 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# 분류 서비스 (anthropic / openai). 모델 ID는 선택한 서비스에 맞게 지정합니다.
CLASSIFY_PROVIDER=anthropic
ESCALATE_PROVIDER=anthropic

# 분류 모델 (1차 분류 / 재판정). 아래는 기존에 선택한 초기 기본값입니다.
CLASSIFY_MODEL=claude-haiku-4-5
ESCALATE_MODEL=claude-sonnet-5-5

# LLM에 가사 전송 여부 (기본 끄기). 켠 경우의 추출·전송 범위는 SPEC §7.5에서 별도 결정합니다.
CLASSIFY_INCLUDE_LYRICS=false

# GUI에서 입력한 키의 저장 방식과 이 파일의 우선순위는 SPEC §15.4의 검토 사항입니다.

# Last.fm API 키 (https://www.last.fm/api/account/create)
LASTFM_API_KEY=

# MusicBrainz 요청 시 필수 User-Agent 연락처 (이메일 또는 URL)
MUSICBRAINZ_CONTACT=
