# .env로 복사해서 사용하세요. .env는 커밋되지 않습니다.

# 음악 폴더 경로
MUSIC_ROOT=

# SQLite DB 파일 경로
DB_PATH=./data/music-sorter.db

# Anthropic API 키 (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# 분류 모델 (1차 분류 / 재판정)
CLASSIFY_MODEL=claude-haiku-4-5
ESCALATE_MODEL=claude-sonnet-5-5

# Last.fm API 키 (https://www.last.fm/api/account/create)
LASTFM_API_KEY=

# MusicBrainz 요청 시 필수 User-Agent 연락처 (이메일 또는 URL)
MUSICBRAINZ_CONTACT=
